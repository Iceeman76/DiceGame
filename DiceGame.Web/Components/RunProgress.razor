<div class="run-progress" aria-label="@Title" aria-busy="@Running">
    <div class="run-progress-heading"><strong>@Title</strong><span>@Percentage.ToString("F1")%</span></div>
    <progress value="@Completed" max="@Total" aria-label="@Title"></progress>
    <div class="run-metrics">
        <span>@Completed.ToString("N0") / @Total.ToString("N0") matches</span>
        <span>Elapsed @FormatDuration(Elapsed)</span>
        @if (Completed > 0 && Elapsed.TotalSeconds > 0)
        {
            <span>@((Completed / Elapsed.TotalSeconds).ToString("N0")) matches/s</span>
            @if (Running && Completed < Total)
            {
                <span>About @FormatDuration(TimeSpan.FromSeconds(Elapsed.TotalSeconds * (Total - Completed) / Completed)) remaining</span>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Progress";
    [Parameter] public long Completed { get; set; }
    [Parameter] public long Total { get; set; }
    [Parameter] public TimeSpan Elapsed { get; set; }
    [Parameter] public bool Running { get; set; }
    private double Percentage => Total > 0 ? 100d * Completed / Total : 0;

    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}h {duration.Minutes}m" : duration.TotalMinutes >= 1 ? $"{(int)duration.TotalMinutes}m {duration.Seconds}s" : $"{duration.Seconds}s";
}
