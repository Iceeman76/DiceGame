<button type="button" class="die @(Selected ? "selected" : "") @(Muted ? "muted" : "") @(Rolling ? "rolling" : "") @(Available ? "available" : "")" disabled="@Disabled" aria-label="@(Available ? "Inherited die available to roll" : Value == 0 ? Muted ? "Die unavailable" : "Die ready to roll" : $"Die {Value}{(Selected ? ", selected" : "")}")" aria-pressed="@(Selected ? "true" : "false")" @onclick="OnClick">
    @for (var position = 0; position < 9; position++)
    {
        <span class="pip @(HasPip(position) ? "visible" : "")"></span>
    }
</button>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Muted { get; set; }
    [Parameter] public bool Rolling { get; set; }
    [Parameter] public bool Available { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool HasPip(int position) => Value switch
    {
        1 => position == 4,
        2 => position is 0 or 8,
        3 => position is 0 or 4 or 8,
        4 => position is 0 or 2 or 6 or 8,
        5 => position is 0 or 2 or 4 or 6 or 8,
        6 => position is 0 or 2 or 3 or 5 or 6 or 8,
        _ => false
    };
}
